# D:\Code\gitRepository\webnovel-writer\.env
# RAG 检索系统的 API 配置 (用来存读你的小说设定和伏笔)

# Embedding 模型配置 (用来将文本转化为向量，默认推荐使用魔搭 ModelScope)
EMBED_API_TYPE=openai
EMBED_BASE_URL=https://api-inference.modelscope.cn/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# ↓ 请替换为你的魔搭 Token (去魔搭官网免费申请)
EMBED_API_KEY=你的魔搭Token

# Reranker 排序模型配置 (用来二次检索排序，默认推荐 Jina AI)
RERANK_API_TYPE=openai
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_MODEL=jina-reranker-v3
# ↓ 请替换为你的 Jina Token (去 Jina AI 官网申请，注册送免费额度)
RERANK_API_KEY=你的JinaToken
